          "auth_required": false,
          "params": {
            "tokenAcceso": "UUID token de acceso"
          }
        },
        {
          "method": "GET",
          "path": "/cotizaciones/public/:id",
          "description": "Obtener cotización por ID (acceso público)",
          "auth_required": false,
          "params": {
            "id": "ObjectId de la cotización (MongoId)"
          }
        },
        {
          "method": "POST",
          "path": "/cotizaciones/public/responder/:tokenAcceso",
          "description": "Responder cotización (acceso público)",
          "auth_required": false,
          "params": {
            "tokenAcceso": "UUID token de acceso"
          },
          "body_dto": "ResponderCotizacionDto",
          "body_example": {
            "status": 1,
            "motivoRechazo": ""
          }
        }
      ]
    },
