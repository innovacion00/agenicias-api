          }
        },
        {
          "method": "POST",
          "path": "/cotizaciones/from-disponibilidad",
          "description": "Crear cotización desde consulta de disponibilidad",
          "auth_required": true,
          "body_dto": "CreateCotizacionDto",
          "note": "Mismo body que crear cotización normal"
        },
        {
          "method": "GET",
          "path": "/cotizaciones/debug-user",
