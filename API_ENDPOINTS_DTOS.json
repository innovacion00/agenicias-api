          "auth_required": true
        },
        {
          "method": "POST",
          "path": "/cotizaciones/test-validation",
          "description": "Endpoint de prueba para validar DTO",
          "auth_required": true,
          "body_dto": "CreateCotizacionDto"
        },
        {
          "method": "GET",
          "path": "/cotizaciones",
          "description": "Obtener todas las cotizaciones de la agencia",
          "auth_required": true
        },
        {
          "method": "GET",
          "path": "/cotizaciones/estadisticas",
          "description": "Obtener estadísticas de cotizaciones de la agencia",
          "auth_required": true
        },
        {
          "method": "GET",
          "path": "/cotizaciones/test-disponibilidad-directa",
          "description": "Endpoint de prueba para verificar disponibilidad",
          "auth_required": true
        },
        {
          "method": "GET",
          "path": "/cotizaciones/:id",
          "description": "Obtener una cotización por ID",
          "auth_required": true,
          "params": {
            "id": "ObjectId de la cotización (MongoId)"
          }
        },
        {
          "method": "GET",
          "path": "/cotizaciones/token/:tokenAcceso",
          "description": "Obtener una cotización por token de acceso (uso interno)",
          "auth_required": false,
          "params": {
            "tokenAcceso": "UUID token de acceso"
          }
        },
        {
          "method": "POST",
          "path": "/cotizaciones/responder/:tokenAcceso",
          "description": "Responder a una cotización (aceptar/rechazar)",
          "auth_required": true,
          "params": {
            "tokenAcceso": "UUID token de acceso"
          },
          "body_dto": "ResponderCotizacionDto",
          "body_example": {
            "status": 1,
            "motivoRechazo": "Precio muy alto"
          },
          "validations": {
            "status": "Enum: 1 (ACEPTADA) o 2 (RECHAZADA)",
            "motivoRechazo": "String opcional, requerido si se rechaza"
          }
        },
        {
          "method": "POST",
          "path": "/cotizaciones/pdf",
          "description": "Generar PDF de una cotización",
          "auth_required": true,
          "body_dto": "GeneratePdfDto",
          "body_example": {
            "cotizacionId": "507f1f77bcf86cd799439011"
          }
        },
        {
          "method": "POST",
          "path": "/cotizaciones/convertir-reserva/:id",
          "description": "Convertir manualmente una cotización en reserva",
          "auth_required": true,
          "params": {
            "id": "ObjectId de la cotización (MongoId)"
          }
        },
        {
          "method": "PATCH",
          "path": "/cotizaciones/:id",
          "description": "Actualizar una cotización",
          "auth_required": true,
          "params": {
            "id": "ObjectId de la cotización (MongoId)"
          },
          "body": "Campos opcionales de CreateCotizacionDto"
        },
        {
          "method": "DELETE",
          "path": "/cotizaciones/:id",
          "description": "Eliminar una cotización",
          "auth_required": true,
          "params": {
            "id": "ObjectId de la cotización (MongoId)"
          }
        }
      ]
    },
    "cotizaciones_public": {
      "base_route": "/cotizaciones/public",
      "endpoints": [
        {
          "method": "GET",
          "path": "/cotizaciones/public/token/:tokenAcceso",
