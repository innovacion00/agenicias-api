{
  "api_version": "1.0",
  "base_url": "/api",
  "modules": {
    "auth": {
      "base_route": "/auth",
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/sign-up/:id",
          "description": "Crear un nuevo usuario asociado a una agencia",
          "auth_required": false,
          "params": {
            "id": "ObjectId de la agencia (MongoId)"
          },
          "body_dto": "CreateUserDto",
          "body_example": {
            "email": "usuario@ejemplo.com",
            "fullName": "Juan Pérez",
            "telefono": "+573001234567",
            "omitirOtp": false,
            "password": "Password123!"
          },
          "validations": {
            "email": "Debe ser un email válido",
            "fullName": "String de 2-50 caracteres",
            "telefono": "String de 7-15 caracteres, debe empezar con +",
            "omitirOtp": "Boolean opcional",
            "password": "String de 6-50 caracteres, debe contener al menos una mayúscula, una minúscula y un número"
          }
        },
        {
          "method": "POST",
          "path": "/auth/register-user",
          "description": "Registrar un usuario a una agencia (solo admin o superAdmin)",
          "auth_required": true,
          "roles": ["admin", "superAdmin"],
          "body_dto": "RegisterUserDto",
          "body_example": {
            "email": "usuario@ejemplo.com",
            "fullName": "Juan Pérez",
            "telefono": "+573001234567",
            "password": "Password123!",
            "adminRole": false
          },
          "validations": {
            "adminRole": "Boolean opcional - define si el usuario tendrá rol de admin"
          }
        },
        {
          "method": "POST",
          "path": "/auth/sign-in",
          "description": "Iniciar sesión",
          "auth_required": false,
          "body_dto": "SignInDto",
          "body_example": {
            "email": "usuario@ejemplo.com",
            "password": "Password123!"
          }
        },
        {
          "method": "POST",
          "path": "/auth/validar-token",
          "description": "Validar un token (deprecated, usar validate-access-token)",
          "auth_required": false,
          "body": "string (token JWT)"
        },
        {
          "method": "POST",
          "path": "/auth/validate-access-token",
          "description": "Validar un access token JWT",
          "auth_required": false,
          "body_dto": "ValidateAccessTokenDto",
          "body_example": {
            "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        {
          "method": "POST",
          "path": "/auth/refresh-token",
          "description": "Refrescar un token de acceso usando el refresh token",
          "auth_required": false,
          "body_dto": "RefreshTokenDto",
          "body_example": {
            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        {
          "method": "POST",
          "path": "/auth/validate-otp",
          "description": "Validar código OTP enviado por email",
          "auth_required": false,
          "body_dto": "OtpValidationDto",
          "body_example": {
            "otp": "12345",
            "email": "usuario@ejemplo.com"
          },
          "validations": {
            "otp": "String de exactamente 5 caracteres",
            "email": "Debe ser un email válido"
          }
        },
        {
          "method": "POST",
          "path": "/auth/request-password-change",
          "description": "Solicitar cambio de contraseña (envía OTP por email)",
          "auth_required": false,
          "body_dto": "RequestPasswordChangeDto",
          "body_example": {
            "email": "usuario@ejemplo.com"
          }
        },
        {
          "method": "PATCH",
          "path": "/auth/new-credentials",
          "description": "Cambiar contraseña del usuario autenticado",
          "auth_required": true,
          "body_dto": "NewPasswordDto",
          "body_example": {
            "password": "NuevaPassword123!"
          }
        },
        {
          "method": "PATCH",
          "path": "/auth/switch-activation-status/:userId",
          "description": "Activar/desactivar un usuario de la agencia",
          "auth_required": true,
          "roles": ["admin", "superAdmin"],
          "params": {
            "userId": "ObjectId del usuario (MongoId)"
          }
        },
        {
          "method": "GET",
          "path": "/auth/getAllUsers",
          "description": "Obtener todos los usuarios del sistema",
          "auth_required": true,
          "roles": ["superAdmin"]
        },
        {
          "method": "PATCH",
          "path": "/auth/politicas-agencia",
          "description": "Actualizar políticas de la agencia del usuario",
          "auth_required": true,
          "body_dto": "UpdatePoliticasDto",
          "body_example": {
            "politicasAgencia": "Políticas de cancelación: 24 horas antes..."
          }
        }
      ]
    },
    "agencias": {
      "base_route": "/agencias",
      "endpoints": [
        {
          "method": "POST",
          "path": "/agencias/create",
          "description": "Crear una nueva agencia",
          "auth_required": false,
          "body_dto": "CreateAgenciaDto",
          "body_example": {
            "fullName": "Agencia de Viajes XYZ",
            "emailContacto": "contacto@agenciaxy.com",
            "telefonoContacto": "+573001234567",
            "category": 0,
            "empresa": true,
            "documentInfo": {
              "tipo": "NIT",
              "document": "900123456"
            }
          },
          "validations": {
            "fullName": "String de 3-100 caracteres",
            "emailContacto": "Debe ser un email válido",
            "telefonoContacto": "String de 7-15 caracteres, debe ser un número de teléfono válido",
            "category": "Número: 0 (minorista) o 1 (mayorista)",
            "empresa": "Boolean opcional - indica si es empresa",
            "documentInfo.tipo": "Enum: 'CC', 'NIT', 'CE', 'PA'",
            "documentInfo.document": "String mínimo 6 caracteres, sin espacios ni guiones bajos"
          }
        },
        {
          "method": "POST",
          "path": "/agencias/recharge-wallet",
          "description": "Recargar billetera de la agencia",
          "auth_required": true,
          "body_dto": "RechargeWalletDto",
          "body_example": {
            "amount": 500000,
            "currency": "COP"
          },
          "validations": {
            "amount": "Número entre 50000 y 50000000",
            "currency": "Solo 'COP' es válido"
          }
        },
        {
          "method": "GET",
          "path": "/agencias/obtener-saldo",
          "description": "Obtener saldo de la billetera de la agencia",
          "auth_required": true
        },
        {
          "method": "GET",
          "path": "/agencias",
          "description": "Obtener todas las agencias",
          "auth_required": true,
          "roles": ["superAdmin"]
        },
        {
          "method": "GET",
          "path": "/agencias/getByProperty",
          "description": "Buscar agencias por propiedad",
          "auth_required": true,
          "roles": ["superAdmin"],
          "query_params": {
            "search": "Término de búsqueda"
          }
        },
        {
          "method": "PATCH",
          "path": "/agencias/update/:id",
          "description": "Actualizar información de una agencia",
          "auth_required": true,
          "roles": ["superAdmin"],
          "params": {
            "id": "ObjectId de la agencia (MongoId)"
          },
          "body_dto": "UpdateAgenciaDto",
          "body_example": {
            "fullName": "Nuevo Nombre de Agencia",
            "emailContacto": "nuevo@email.com"
          }
        },
        {
          "method": "PATCH",
          "path": "/agencias/switch-activation-agencia/:agenciaId",
          "description": "Activar/desactivar una agencia",
          "auth_required": true,
          "roles": ["superAdmin"],
          "params": {
            "agenciaId": "ObjectId de la agencia (MongoId)"
          }
        },
        {
          "method": "GET",
          "path": "/agencias/agencies-by-term",
          "description": "Buscar agencias por término",
          "auth_required": false,
          "query_params": {
            "search": "Término de búsqueda"
          }
        },
        {
          "method": "GET",
          "path": "/agencias/agencias-con-reserva",
          "description": "Obtener conteo de agencias con reservas",
          "auth_required": true,
          "roles": ["superAdmin"]
        }
      ]
    },
