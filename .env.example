# Agencias API Environment Configuration
# Copy this file to .env and fill in the values for your environment
# Variables marked as SECRET require sensitive credentials
# Variables marked as CONFIG are typically non-sensitive settings

# ============================================================================
# APPLICATION
# ============================================================================

# Puerto en el que escucha la aplicación (CONFIG)
PORT=3000

# ============================================================================
# JWT & AUTENTICACIÓN
# ============================================================================

# Clave secreta para firmar JWT tokens (SECRET)
JWT_SECRET=your-jwt-secret-here-change-in-production

# ============================================================================
# BASE DE DATOS (MONGODB)
# ============================================================================

# URL de conexión a MongoDB (CONFIG - puede apuntar a desarrollo o producción)
MONGO_URL=mongodb://localhost:27017/agencias-api

# ============================================================================
# AUTOCORE - Cartera y Backend de Reservas
# ============================================================================

# URL base del API de Autocore (CONFIG)
AUTOCORE_URL=https://api.autocore.com/v1

# Clave de acceso para Autocore (SECRET)
AUTOCORE_ACCESS_KEY=your-autocore-access-key

# Clave secreta para Autocore (SECRET)
AUTOCORE_SECRET_KEY=your-autocore-secret-key

# Credenciales de desarrollo para Autocore - opcional (SECRET)
AUTOCORE_URL_DEV=https://dev.autocore.com/v1
AUTOCORE_ACCESS_KEY_DEV=your-autocore-dev-access-key
AUTOCORE_SECRET_KEY_DEV=your-autocore-dev-secret-key

# ============================================================================
# MY TOOL - Motor de Reserva Hotelera
# ============================================================================

# Email de cuenta My Tool (CONFIG)
MY_TOOL_EMAIL=your-mytool-email@example.com

# Contraseña de acceso My Tool (SECRET)
MY_TOOL_CLAVE=your-mytool-password

# URLs de API para cada propiedad hotelera (SECRET - son tokens/claves de acceso)
API_AIXO=https://api.mytool.com/hook/aixo/token-here
API_AZUAN=https://api.mytool.com/hook/azuan/token-here
API_RODADERO=https://api.mytool.com/hook/rodadero/token-here
API_AVEXI=https://api.mytool.com/hook/avexi/token-here
API_BOCAGRANADE=https://api.mytool.com/hook/bocagranade/token-here
API_ABI=https://api.mytool.com/hook/abi/token-here
API_MADISSON=https://api.mytool.com/hook/madisson/token-here
API_WINDSOR=https://api.mytool.com/hook/windsor/token-here
API_MARINA=https://api.mytool.com/hook/marina/token-here
API_AXIS=https://api.mytool.com/hook/axis/token-here
API_MARQUES=https://api.mytool.com/hook/marques/token-here
API_SANSIRAKA=https://api.mytool.com/hook/sansiraka/token-here
API_PLAYASALGUERO=https://api.mytool.com/hook/playasalguero/token-here

# ============================================================================
# AMADEUS - Búsqueda y Reserva de Vuelos
# ============================================================================

# Clave de API de Amadeus (SECRET)
AMADEUS_API_KEY=your-amadeus-api-key

# Clave secreta de Amadeus (SECRET)
AMADEUS_API_SECRET=your-amadeus-api-secret

# URL base del API de Amadeus (CONFIG)
AMADEUS_BASE_URL=https://api.amadeus.com

# ============================================================================
# MAARLAB / OCEANFLIGHTS - Búsqueda Avanzada de Vuelos
# ============================================================================

# URL base del API de MaarLab (CONFIG)
MAARLAB_BASE_URL=https://api.maarlab.com/v1

# DEPRECATED: NO utilizar. El Bearer de solicitud proviene de Agencia.maarlabApiKey (SECRET - DEPRECATED)
# MAARLAB_AUTH_TOKEN=

# Bearer de nivel partner para sincronizar API keys por agencia (SECRET)
# Utilizado solo en el script de mantenimiento: npm run sync:maarlab-keys
MAARLAB_PARTNER_SYNC_BEARER=your-maarlab-partner-bearer-token

# UUID de cadena MaarLab para id_chain_search_engine (CONFIG)
# Utilizado en scripts de sincronización
MAARLAB_CHAIN_SEARCH_ENGINE_ID=your-maarlab-chain-id

# ============================================================================
# BOOKING PERSONAS - Servicio de Reserva Auxiliar
# ============================================================================

# Token de autenticación para Booking Personas (SECRET)
BOOKING_PERSONAS_TOKEN=your-booking-personas-token

# ============================================================================
# COBRE - Generador de Enlaces de Pago
# ============================================================================

# URL base del API de Cobre (CONFIG)
COBRE_API_URL=https://api.cobre.com/v1

# ID de usuario en Cobre (SECRET)
COBRE_USER_ID=your-cobre-user-id

# Clave secreta de Cobre (SECRET)
COBRE_SECRET=your-cobre-secret

# String de autenticación para Cobre (SECRET)
COBRE_AUTH_STRING=your-cobre-auth-string

# Clave API de Cobre (SECRET)
COBRE_API_KEY=your-cobre-api-key

# ============================================================================
# CLOUDINARY - Almacenamiento de Archivos e Imágenes
# ============================================================================

# Nombre de la cuenta Cloudinary (CONFIG)
CLOUDINARY_NAME=your-cloudinary-name

# Clave de API de Cloudinary (SECRET)
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Clave secreta de Cloudinary (SECRET)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================================================
# CORREO ELECTRÓNICO
# ============================================================================

# ---- Node Mailer (Gmail SMTP) ----

# Email remitente para envíos vía Nodemailer (CONFIG)
SENDER_EMAIL=noreply@agencias.com

# Contraseña de aplicación de Gmail (SECRET)
EMAIL_APP_PASSWORD=your-gmail-app-password

# ---- SendGrid ----

# Clave API de SendGrid (SECRET)
SENDGRID_API_KEY=your-sendgrid-api-key

# ---- Google Gmail API ----

# Access Token del API de Google Gmail (se refresca automáticamente) (SECRET)
GOOGLE_GMAIL_API_KEY=your-google-gmail-access-token

# URL del API de Google Gmail (CONFIG)
GOOGLE_GMAIL_URL=https://www.googleapis.com/gmail/v1

# ID de cliente de Google (SECRET)
GOOGLE_GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Clave secreta de cliente de Google (SECRET)
GOOGLE_GMAIL_CLIENT_SECRET=your-google-client-secret

# Refresh Token para obtener nuevos access tokens (SECRET)
GOOGLE_GMAIL_REFRESH_TOKEN=your-google-refresh-token

# ============================================================================
# SERVICIOS EXTERNOS
# ============================================================================

# URL del host Bridge Chat (CONFIG)
HOST_BRIDGE=https://bridge.example.com

# ============================================================================
# REDIS (opcional)
# ============================================================================

# URL de conexión a Redis (CONFIG, opcional)
# Sin esta variable, throttler y caches usan memoria local
# REDIS_URL=redis://localhost:6379
