{
  "info": {
    "name": "Agencias API - Cotizaciones",
    "description": "Flujo completo: disponibilidad, cotizaciones privadas y endpoints públicos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Sign In (obtener token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/auth/sign-in",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sign-in"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"innovacion@gehsuites.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Reservas - Disponibilidad",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservas/disponibilidad",
          "host": ["{{baseUrl}}"],
          "path": ["reservas", "disponibilidad"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"checkingDate\": \"{{checkin}}\",\n  \"nights\": {{nights}},\n  \"ciudad\": \"{{ciudad}}\",\n  \"layout\": [ { \"adults\": 2, \"children_ages\": [] } ],\n  \"category\": 1\n}"
        }
      }
    },
    {
      "name": "Cotizaciones - Crear desde disponibilidad",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/from-disponibilidad",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "from-disponibilidad"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titularInfo\": {\n    \"firstName\": \"Juan\",\n    \"lastName\": \"Pérez\",\n    \"email\": \"juan@example.com\",\n    \"telephone\": \"+57 3000000000\",\n    \"tipoDocumento\": \"CC\",\n    \"numeroDocumento\": \"123456789\"\n  },\n  \"reservaInfo\": {\n    \"reservation\": {\n      \"checkin\": \"{{checkin}}\",\n      \"checkout\": \"{{checkout}}\",\n      \"nights\": \"{{nights}}\",\n      \"adults\": \"2\",\n      \"children\": \"0\",\n      \"rooms\": \"1\",\n      \"roomsData\": [\n        { \"nombreHabitacion\": \"Habitacion Doble Standard\", \"roomId\": \"83528\", \"roomName\": \"Habitacion Doble Standard\" }\n      ],\n      \"firstName\": \"Juan\",\n      \"lastName\": \"Pérez\",\n      \"email\": \"juan@example.com\",\n      \"telephone\": \"+57 3000000000\"\n    }\n  },\n  \"total\": 1000000,\n  \"fechaLimiteRespuesta\": \"{{fechaLimiteRespuesta}}\"\n}"
        }
      }
    },
    {
      "name": "Cotizaciones - Landing data",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/landing/{{cotizacionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "landing", "{{cotizacionId}}"]
        }
      }
    },
    {
      "name": "Cotizaciones - Store landing HTML",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/store-landing",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "store-landing"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cotizacionId\": \"{{cotizacionId}}\",\n  \"landingHtml\": \"<!doctype html><html><head><meta charset=\\\"utf-8\\\"><title>Cotización</title></head><body><h1>Cotización</h1><p>Contenido...</p></body></html>\"\n}"
        }
      }
    },
    {
      "name": "Cotizaciones - Público - Obtener por token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/public/token/{{tokenAcceso}}",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "public", "token", "{{tokenAcceso}}"]
        }
      }
    },
    {
      "name": "Cotizaciones - Público - Responder (aceptar)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/public/responder/{{tokenAcceso}}",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "public", "responder", "{{tokenAcceso}}"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"status\": 1\n}" }
      }
    },
    {
      "name": "Cotizaciones - Público - Responder (rechazar)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/public/responder/{{tokenAcceso}}",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "public", "responder", "{{tokenAcceso}}"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"status\": 2,\n  \"motivoRechazo\": \"No me interesa\"\n}" }
      }
    },
    {
      "name": "Cotizaciones - Generar PDF",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/pdf",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "pdf"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"cotizacionId\": \"{{cotizacionId}}\"\n}" }
      }
    },
    {
      "name": "Cotizaciones - Convertir a reserva",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/cotizaciones/convertir-reserva/{{cotizacionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cotizaciones", "convertir-reserva", "{{cotizacionId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/agencias/v1" },
    { "key": "token", "value": "" },
    { "key": "checkin", "value": "2025-11-20" },
    { "key": "checkout", "value": "2025-11-22" },
    { "key": "nights", "value": "2" },
    { "key": "ciudad", "value": "CARTAGENA" },
    { "key": "fechaLimiteRespuesta", "value": "2025-11-27" },
    { "key": "cotizacionId", "value": "" },
    { "key": "tokenAcceso", "value": "" }
  ]
}


